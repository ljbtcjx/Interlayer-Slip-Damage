&GLOBAL
  PROJECT Cf_SiC_Tensile_Step1      ! 任务名称
  RUN_TYPE GEO_OPT                  ! 几何优化：寻找拉伸后的局部基态
  PRINT_LEVEL LOW
&END GLOBAL

&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    MAX_ITER 100                    ! 拉伸步长较小时，100步通常足以收敛
    OPTIMIZER BFGS
  &END GEO_OPT

  &CONSTRAINT
    &FIXED_ATOMS
      ! --- 底部固定的 SiC 基底 (Z < 8.5 A) ---
      LIST 1 7 13 19 25 31 37 43 49 55 61 67 73 79 85
      LIST 91 97 103 109 115 121 127 133 139 185 186 191 192 197 198
      LIST 203 204 209 210 215 216 221 222 227 228 233 234 239 240 245
      LIST 246 251 252 257 258 263 264 269 270 275 276 281 282 287 288
      LIST 293 294 299 300 305 306 311 312 317 318 323 324

      ! --- 顶部被拉拽的碳层 (Z > 25.0 A) ---
      LIST 145 146 147 148 149 150 151 152 153 154
    &END FIXED_ATOMS
  &END CONSTRAINT
&END MOTION

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    
    ! 🎯 极速收敛关键：继承之前的波函数
    WFN_RESTART_FILE_NAME Cf_SiC_Relax_New-RESTART.wfn
    
    ! 🎯 应对断键产生的孤对电子，开启自旋极化
    UKS .TRUE.
    MULTIPLICITY 1
    
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    
    &SCF
      MAX_SCF 200
      EPS_SCF 1.0E-6
      SCF_GUESS RESTART             ! 从波函数重启
      ADDED_MOS 100                 ! 应对金属性/窄能隙
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
      &OUTER_SCF
        MAX_SCF 10
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF
    
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
         POTENTIAL_TYPE PAIR_POTENTIAL
         &PAIR_POTENTIAL
            PARAMETER_FILE_NAME dftd3.dat
            TYPE DFTD3
            REFERENCE_FUNCTIONAL PBE
         &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      A   12.3319422638933904    0.0000000000000000    0.0000000000000000
      B    0.0000000000000000   16.0196629178019876    0.0000000000000000
      ! 🎯 关键：Z轴长度已由 34.47417 加长至 34.67417
      C    0.0000000000000000    0.0000000000000000   34.6741712485839216
    &END CELL
    
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME ./step_1.xyz  
    &END TOPOLOGY
    
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL