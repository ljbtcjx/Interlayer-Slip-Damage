&GLOBAL
  PROJECT Cf_SiC_Tensile_Step5
  RUN_TYPE GEO_OPT
  PRINT_LEVEL LOW
&END GLOBAL

&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    MAX_ITER 100
    OPTIMIZER BFGS
  &END GEO_OPT

  &CONSTRAINT
    &FIXED_ATOMS
      ! --- 底部固定的 SiC 基底 ---
      LIST 1 7 13 19 25 31 37 43 49 55 61 67 73 79 85
      LIST 91 97 103 109 115 121 127 133 139 185 186 191 192 197 198
      LIST 203 204 209 210 215 216 221 222 227 228 233 234 239 240 245
      LIST 246 251 252 257 258 263 264 269 270 275 276 281 282 287 288
      LIST 293 294 299 300 305 306 311 312 317 318 323 324
      ! --- 顶部被拉拽的碳层 ---
      LIST 145 146 147 148 149 150 151 152 153 154
    &END FIXED_ATOMS
  &END CONSTRAINT
&END MOTION

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL
    
    ! 🎯 动态继承上一步的波函数
    WFN_RESTART_FILE_NAME Cf_SiC_Tensile_Step4-RESTART.wfn
    
    UKS .TRUE.
    MULTIPLICITY 1
    
    &MGRID
      CUTOFF 400
      REL_CUTOFF 60
    &END MGRID
    
    &SCF
      MAX_SCF 200
      EPS_SCF 1.0E-6
      SCF_GUESS RESTART
      ADDED_MOS 100
      &SMEAR
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.4
        NBROYDEN 8
      &END MIXING
      &OUTER_SCF
        MAX_SCF 10
        EPS_SCF 1.0E-6
      &END OUTER_SCF
    &END SCF
    
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
         POTENTIAL_TYPE PAIR_POTENTIAL
         &PAIR_POTENTIAL
            PARAMETER_FILE_NAME dftd3.dat
            TYPE DFTD3
            REFERENCE_FUNCTIONAL PBE
         &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      A   12.3319422638933904    0.0000000000000000    0.0000000000000000
      B    0.0000000000000000   16.0196629178019876    0.0000000000000000
      ! 🎯 动态加长 C 轴
      C    0.0000000000000000    0.0000000000000000   35.4741712485839216
    &END CELL
    
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME ./step_5.xyz  
    &END TOPOLOGY
    
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
