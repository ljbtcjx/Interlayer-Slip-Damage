! Finite smooth interface; grip +Z displacement = 2.2 angstrom.
! Coordinates for loading steps depend on preceding converged relaxation.
&GLOBAL
  PROJECT Smooth_SP_11
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
  PREFERRED_FFT_LIBRARY FFTSG
&END GLOBAL
&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    WFN_RESTART_FILE_NAME Smooth_Relax_11-RESTART.wfn
    CHARGE 0
    UKS TRUE
    MULTIPLICITY 1
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &MGRID
      CUTOFF [Ry] 400
      REL_CUTOFF [Ry] 60
    &END MGRID
    &POISSON
      PERIODIC NONE
      POISSON_SOLVER WAVELET
    &END POISSON
    &SCF
      MAX_SCF 200
      EPS_SCF 1.0E-6
      SCF_GUESS RESTART
      IGNORE_CONVERGENCE_FAILURE FALSE
      ADDED_MOS 100
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &SMEAR
        METHOD FERMI_DIRAC
        ! Numerical electronic smearing; this is not a 300 K ionic MD run.
        ELECTRONIC_TEMPERATURE [K] 300
      &END SMEAR
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.1
        NBROYDEN 8
      &END MIXING
      &OUTER_SCF
        MAX_SCF 10
        EPS_SCF 1.0E-6
      &END OUTER_SCF
      &PRINT
        &RESTART ON
        &END RESTART
      &END PRINT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &PRINT
      &HIRSHFELD ON
      &END HIRSHFELD
      &MULLIKEN ON
      &END MULLIKEN
      &MOMENTS ON
        MAX_MOMENT 1
      &END MOMENTS
      &E_DENSITY_CUBE ON
        STRIDE 2 2 2
      &END E_DENSITY_CUBE
      &ELF_CUBE ON
        STRIDE 2 2 2
      &END ELF_CUBE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      ABC [angstrom] 40 35 47
      PERIODIC NONE
    &END CELL
    &TOPOLOGY
      COORD_FILE_FORMAT XYZ
      COORD_FILE_NAME relaxed_11.xyz
    &END TOPOLOGY
    &KIND C
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
